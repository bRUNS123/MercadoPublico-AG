# Logs
logs
*.log
npm-debug.log*

# Dependencies
node_modules/

# Build
dist/

# Snapshot de Compra Ágil (se genera localmente y se publica solo en gh-pages)
# Se ignora todo public/data/ EXCEPTO mis-adjudicaciones.json, que se commitea
# para que sobreviva a los deploys automáticos de hermes (el snapshot sí se regenera).
public/data/*
!public/data/mis-adjudicaciones.json
scripts/update-compra-agil.log
scripts/sync-status.json
scripts/.snapshot-running.lock
scripts/.escritorio-token
scripts/.relay-key

# Environment
.env
.env.local
.env.*.local

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
